// Cloudflare Workers hosting: serves the Vite build from dist/. A small Worker (src/worker)
// runs only for page requests to redirect plain HTTP to HTTPS; build files are served directly.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doroboty-ai",
  "compatibility_date": "2026-11-11",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/case/*", "!/company-logos/*", "!/cv/*"],
  },
  // Pull request branches get a Preview build on Cloudflare; `wrangler preview` requires this block.
  "previews": {},
}
